    }

    local function tr(s)
        if type(s) ~= "string" then return s end
        if T[s] then return T[s] end
        for k,v in pairs(T) do
            if s:find(k) then
                return s:gsub(k,v)
            end
        end
        return s
    end

    local done = {}
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")

    local function scan(parent)
        if not parent then return end
        pcall(function()
            for _, o in ipairs(parent:GetDescendants()) do
                if not done[o] and (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then
                    pcall(function()
                        local t = o.Text
                        if t and t ~= "" then
                            local n = tr(t)
                            if n ~= t then
                                o.Text = n
                                done[o] = true
                            end
                        end
                    end)
                end
            end
        end)
    end

    local function setupListener(parent)
        if not parent then return end
        pcall(function()
            parent.DescendantAdded:Connect(function(descendant)
                task.wait(0.1)
                pcall(function()
                    if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                        local t = descendant.Text
                        if t and t ~= "" then
                            local n = tr(t)
                            if n ~= t then
                                descendant.Text = n
                            end
                        end
                    end
                end)
            end)
        end)
    end

    local p = Players.LocalPlayer

    scan(CoreGui)
    if p and p:FindFirstChild("PlayerGui") then
        scan(p.PlayerGui)
    end

    setupListener(CoreGui)
    if p and p:FindFirstChild("PlayerGui") then
        setupListener(p.PlayerGui)
    end

    spawn(function()
        while true do
            wait(1)
            scan(CoreGui)
            if p and p:FindFirstChild("PlayerGui") then
                scan(p.PlayerGui)
            end
        end
    end)

    loadstring(game:HttpGet("https://raw.githubusercontent.com/stormzdev/universal/refs/heads/main/dropkick.lua"))()
end
